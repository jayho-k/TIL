POSTGRES_DSN=postgresql+asyncpg://agent:change-me@localhost:5432/agent_streaming
REDIS_URL=redis://localhost:6379
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=replace-me
OLLAMA_API_KEY=ollama
OLLAMA_REASONING_EFFORT_ENABLED=true

MAX_SSE_CONNECTIONS=30
MAX_AGENT_RUNS=10
HEARTBEAT_SECONDS=15
SEND_TIMEOUT_SECONDS=30
AGENT_TIMEOUT_SECONDS=600
PERMIT_TIMEOUT_SECONDS=5
TOKEN_BATCH_MAX_CHARS=128
TOKEN_BATCH_MAX_DELAY_SECONDS=0.02
